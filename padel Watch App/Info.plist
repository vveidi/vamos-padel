<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Матч выполняется внутри тренировки, и это единственный ключ, ради
	     которого файлу вообще положено существовать: остальные Xcode
	     генерирует из настроек сборки, а массив он генерировать не умеет.
	     Без workout-processing система выгрузила бы приложение между геймами
	     и не включила бы Always-On. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
</dict>
</plist>
